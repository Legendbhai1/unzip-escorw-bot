# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string (Render provides this automatically for a linked DB)
DATABASE_URL=

# Comma-separated Telegram numeric user IDs with top-level admin rights
ADMIN_IDS=

# Support contact shown in /support (default: beinglazyyy)
SUPPORT_USERNAME=beinglazyyy

# Optional fallback bot @username for the group escrow form's verification tag.
# The bot fetches its real username automatically at launch (via getMe()) and
# prefers that; this is only used if that lookup ever fails.
BOT_USERNAME=

# Optional links shown in the bot's info screens
ESCROW_GROUP_URL=
INFO_CHANNEL_URL=

# Auto-cancel inactivity window in hours (default 24)
INACTIVITY_TIMEOUT_HOURS=24

# Warning checkpoints in hours (comma-separated, default 12,23)
INACTIVITY_WARNING_HOURS=12,23

# Default escrow fee percentage (default 0)
DEFAULT_FEE_PERCENT=0

# Port for health check server
PORT=3000
