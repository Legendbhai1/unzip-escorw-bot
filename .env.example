# ── Telegram ──────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_TELEGRAM_IDS=123456789

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://escrow:escrow_pass@localhost:5432/escrow_db

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Tron (USDT TRC20) ───────────────────────────
TRON_API_KEY=your_trongrid_api_key
TRON_CONTRACT_USDT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
DEPOSIT_ADDRESS_TRC20=

# ── BSC (USDT BEP20) ─────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_CONTRACT_USDT=0x55d398326f99059fF775485246999027B3197955
DEPOSIT_ADDRESS_BEP20=

# ── Withdrawal Signer ───────────────────────────
WITHDRAWAL_SIGNER_PRIVATE_KEY=
WITHDRAWAL_MIN_CONFIRMATIONS=3

# ── App ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
MONITOR_POLL_INTERVAL_MS=15000
RECONCILIATION_INTERVAL_MS=900000

# ── Escrow Group (deal form posts) ───────────────
# Numeric chat id of the group where created deal cards are posted.
# Optional: if unset, the deal card is only shown to the creator in DM.
ESCROW_GROUP_ID=
