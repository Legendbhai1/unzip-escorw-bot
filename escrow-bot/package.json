{
  "name": "escrow-bot",
  "version": "1.0.0",
  "description": "P2P Crypto Escrow Telegram Bot - Custodial escrow for legitimate trades",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:withdrawal": "tsx src/workers/withdrawal.ts",
    "worker:blockchain": "tsx src/workers/blockchain.ts",
    "worker:reconciliation": "tsx src/workers/reconciliation.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/conversations": "^1.2.0",
    "@grammyjs/menu": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "bull": "^4.16.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "grammy": "^1.35.0",
    "ioredis": "^5.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/node": "^22.20.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
