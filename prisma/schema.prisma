generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum DealStatus {
  CREATED
  JOINED
  AWAITING_FUNDING
  FUNDED
  IN_PROGRESS
  DELIVERED
  RELEASE_PENDING
  COMPLETED
  DISPUTED
  UNDER_REVIEW
  REFUNDED
  RELEASED
  CANCELLED
  EXPIRED
}

enum DealRole {
  BUYER
  SELLER
}

enum DealCategory {
  FREELANCE_SERVICES
  PHYSICAL_GOODS
  GIFT_CARDS
  OTHER_LAWFUL
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DisputeStatus {
  OPENED
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolution {
  RELEASE_TO_SELLER
  REFUND_BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
  FEE
}

enum ReferenceType {
  DEAL
  TRANSACTION
  DISPUTE
  WITHDRAWAL_REQUEST
  BLOCKCHAIN_DEPOSIT
}

enum AdminActionType {
  DISPUTE_RESOLVE_RELEASE
  DISPUTE_RESOLVE_REFUND
  DEAL_CANCEL
  USER_SUSPEND
  USER_BAN
  WITHDRAWAL_APPROVE
  WITHDRAWAL_REJECT
}

enum WithdrawalRequestStatus {
  PENDING
  RESERVING
  QUEUED
  BROADCASTING
  CONFIRMING
  COMPLETED
  FAILED
  REVERSED
}

// ─── Users ───────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramId  BigInt     @unique @map("telegram_id")
  username    String?    @db.VarChar(64)
  firstName   String     @map("first_name") @db.VarChar(128)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  balances            Balance[]
  dealsAsBuyer       Deal[]     @relation("BuyerDeals")
  dealsAsSeller      Deal[]     @relation("SellerDeals")
  transactions        Transaction[]
  ledgerEntries       LedgerEntry[]
  disputesOpened      Dispute[]   @relation("DisputeOpener")
  disputesResolved    Dispute[]   @relation("DisputeResolver")
  adminActions        AdminAction[]
  withdrawalRequests  WithdrawalRequest[]
  blockchainDeposits  BlockchainDeposit[]

  @@map("users")
}

// ─── Balances (dual-layer: available + locked) ───────────────────────────

model Balance {
  userId    String  @map("user_id") @db.Uuid
  asset     String  @db.VarChar(10)
  available Decimal @default(0) @db.Decimal(18, 8)
  locked    Decimal @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, asset])
  @@map("balances")
}

// ─── Deals ───────────────────────────────────────────────────────────────
// No deal-specific deposit fields. Deposits go to user wallets first.
// Deals are funded from available balance.

model Deal {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteCode           String        @unique @map("invite_code") @db.VarChar(12)
  buyerId              String        @map("buyer_id") @db.Uuid
  sellerId             String?       @map("seller_id") @db.Uuid
  asset                String        @db.VarChar(10)
  network              String        @db.VarChar(20)
  amount               Decimal       @db.Decimal(18, 8)
  buyerFeeBps          Int           @default(100) @map("buyer_fee_bps") // basis points, e.g. 100 = 1%
  sellerFeeBps         Int           @default(100) @map("seller_fee_bps")
  buyerFeeAmount       Decimal       @default(0) @map("buyer_fee_amount") @db.Decimal(18, 8) // fee collected at funding
  sellerFeeAmount      Decimal       @default(0) @map("seller_fee_amount") @db.Decimal(18, 8) // fee collected at release
  description          String        @db.Text
  category             DealCategory
  status               DealStatus
  expiresAt            DateTime?     @map("expires_at") @db.Timestamptz()
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz()

  buyer  User?  @relation("BuyerDeals", fields: [buyerId], references: [id])
  seller User?  @relation("SellerDeals", fields: [sellerId], references: [id])

  transactions   Transaction[]
  ledgerEntries LedgerEntry[]
  dispute       Dispute?
  adminActions  AdminAction[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status])
  @@index([status, expiresAt])
  @@map("deals")
}

// ─── Ledger Transactions (grouping container) ────────────────────────────
// Every economic event is a LedgerTransaction containing 2+ LedgerEntries
// that MUST net to zero.

model LedgerTransaction {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String           @db.VarChar(32) // DEPOSIT, ESCROW_FUND, ESCROW_RELEASE, REFUND, WITHDRAWAL, WITHDRAWAL_REVERSAL
  asset           String           @db.VarChar(10)
  amount          Decimal          @db.Decimal(18, 8) // principal amount for this operation
  network         String?          @db.VarChar(20)
  idempotencyKey  String           @unique @map("idempotency_key") @db.VarChar(128)
  dealId          String?          @map("deal_id") @db.Uuid
  referenceType   String?          @map("reference_type") @db.VarChar(32)
  referenceId     String?          @map("reference_id") @db.Uuid
  entries         LedgerEntry[]
  withdrawalReqs  WithdrawalRequest[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([type, createdAt])
  @@index([dealId])
  @@index([idempotencyKey])
  @@map("ledger_transactions")
}

// ─── Ledger Entries (immutable, double-entry) ─────────────────────────────
// Positive = credit, Negative = debit.
// balanceAfter = the user's available+locked total for this asset AFTER this entry.

model LedgerEntry {
  id             BigInt            @id @default(autoincrement())
  ledgerTxId     String            @map("ledger_tx_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  dealId         String?           @map("deal_id") @db.Uuid
  type           LedgerEntryType
  amount         Decimal           @db.Decimal(18, 8)  // signed: positive=credit, negative=debit
  asset          String            @db.VarChar(10)
  balanceAfter   Decimal           @map("balance_after") @db.Decimal(18, 8) // available+locked after this op
  referenceType  ReferenceType?
  referenceId    String?           @map("reference_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  ledgerTx   LedgerTransaction @relation(fields: [ledgerTxId], references: [id])
  user       User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal       Deal?  @relation(fields: [dealId], references: [id])

  @@index([userId, createdAt])
  @@index([ledgerTxId])
  @@map("ledger_entries")
}

// ─── Blockchain Deposits (tracks on-chain deposits to user wallets) ──────
// Unique on (network, txHash, logIndex) to prevent double-crediting.

model BlockchainDeposit {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  txHash          String           @map("tx_hash") @db.VarChar(128)
  logIndex        Int              @default(0) @map("log_index")
  fromAddress     String           @map("from_address") @db.VarChar(128)
  toAddress       String           @map("to_address") @db.VarChar(128)
  asset           String           @db.VarChar(10)
  network         String           @db.VarChar(20)
  amount          Decimal          @db.Decimal(18, 8)
  confirmations   Int              @default(0)
  requiredConfs   Int              @default(20) @map("required_confs")
  status          TransactionStatus @default(PENDING)
  creditedAt      DateTime?        @map("credited_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([network, txHash, logIndex], name: "blockchain_deposit_unique")
  @@index([userId, createdAt])
  @@index([status, network])
  @@index([toAddress])
  @@map("blockchain_deposits")
}

// ─── Transactions (user-facing view) ─────────────────────────────────────

model Transaction {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      TransactionType
  asset     String           @db.VarChar(10)
  amount    Decimal          @db.Decimal(18, 8)
  status    TransactionStatus @default(PENDING)
  txHash    String?          @map("tx_hash") @db.VarChar(128)
  dealId    String?          @map("deal_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal? @relation(fields: [dealId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("transactions")
}

// ─── Withdrawal Requests ─────────────────────────────────────────────────

model WithdrawalRequest {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  asset           String                 @db.VarChar(10)
  amount          Decimal                @db.Decimal(18, 8)
  network         String                 @db.VarChar(20)
  toAddress       String                 @map("to_address") @db.VarChar(128)
  status          WithdrawalRequestStatus @default(PENDING)
  idempotencyKey  String                 @unique @map("idempotency_key") @db.VarChar(128)
  txHash          String?                @map("tx_hash") @db.VarChar(128)
  ledgerTxId      String?                @map("ledger_tx_id") @db.Uuid
  error           String?                @db.Text
  reservedAt      DateTime?              @map("reserved_at") @db.Timestamptz()
  queuedAt        DateTime?              @map("queued_at") @db.Timestamptz()
  broadcastAt     DateTime?              @map("broadcast_at") @db.Timestamptz()
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz()
  failedAt        DateTime?              @map("failed_at") @db.Timestamptz()
  reversedAt      DateTime?              @map("reversed_at") @db.Timestamptz()
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  user    User              @relation(fields: [userId], references: [id])
  ledgerTx LedgerTransaction? @relation(fields: [ledgerTxId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

// ─── Disputes ─────────────────────────────────────────────────────────────

model Dispute {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId         String             @unique @map("deal_id") @db.Uuid
  openedBy       String             @map("opened_by") @db.Uuid
  reason         String             @db.Text
  status         DisputeStatus      @default(OPENED)
  resolution     DisputeResolution?
  assignedAdmin  String?            @map("assigned_admin") @db.Uuid
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz()
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  deal          Deal?  @relation(fields: [dealId], references: [id])
  opener        User?  @relation("DisputeOpener", fields: [openedBy], references: [id])
  resolver      User?  @relation("DisputeResolver", fields: [assignedAdmin], references: [id])
  evidence      DisputeEvidence[]

  @@map("disputes")
}

// ─── Dispute Evidence ────────────────────────────────────────────────────

model DisputeEvidence {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  submittedBy String  @map("submitted_by") @db.Uuid
  message   String   @db.Text
  fileType  String?  @map("file_type") @db.VarChar(50)
  fileId    String?  @map("file_id") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_evidence")
}

// ─── Admin Actions (audit trail for admin financial ops) ─────────────────

model AdminAction {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String           @map("admin_id") @db.Uuid
  actionType AdminActionType @map("action_type")
  dealId    String?          @map("deal_id") @db.Uuid
  reason    String           @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  admin User @relation(fields: [adminId], references: [id])
  deal  Deal? @relation(fields: [dealId], references: [id])

  @@index([adminId, createdAt])
  @@map("admin_actions")
}