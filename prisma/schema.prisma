generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum DealStatus {
  CREATED
  JOINED
  // Legacy state (custodial era) — kept for historical rows and the legacy
  // ledger tests. New deals never enter it.
  AWAITING_FUNDING
  // Manual-payment flow states.
  AWAITING_PAYMENT
  PAYMENT_REPORTED
  FUNDED
  IN_PROGRESS
  DELIVERED
  RELEASE_REQUESTED
  REFUND_REQUESTED
  // Legacy state (custodial era) — kept for historical rows + ledger tests.
  RELEASE_PENDING
  COMPLETED
  DISPUTED
  UNDER_REVIEW
  REFUNDED
  RELEASED
  CANCELLED
  EXPIRED
}

enum DealRole {
  BUYER
  SELLER
}

enum DealCategory {
  FREELANCE_SERVICES
  PHYSICAL_GOODS
  GIFT_CARDS
  OTHER_LAWFUL
}

enum PaymentMethod {
  INR
  CRYPTO
}

enum PaymentReportStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CryptoPayer {
  BUYER
  SELLER
}

enum EscrowAuditAction {
  DEAL_CREATED
  ADMIN_ACCEPTED
  PAYMENT_INSTRUCTIONS_SENT
  PAYMENT_REPORTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  EVIDENCE_REQUESTED
  EVIDENCE_SUBMITTED
  DELIVERY_MARKED
  RELEASE_REQUESTED
  RELEASE_AGREED
  MANUAL_RELEASE_CONFIRMED
  REFUND_REQUESTED
  REFUND_AGREED
  MANUAL_REFUND_CONFIRMED
  FEE_RECORDED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DisputeStatus {
  OPENED
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolution {
  RELEASE_TO_SELLER
  REFUND_BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
  FEE
}

enum ReferenceType {
  DEAL
  TRANSACTION
  DISPUTE
  WITHDRAWAL_REQUEST
  BLOCKCHAIN_DEPOSIT
}

enum AdminActionType {
  DISPUTE_RESOLVE_RELEASE
  DISPUTE_RESOLVE_REFUND
  DEAL_CANCEL
  USER_SUSPEND
  USER_BAN
  WITHDRAWAL_APPROVE
  WITHDRAWAL_REJECT
}

enum WithdrawalRequestStatus {
  PENDING
  RESERVING
  QUEUED
  BROADCASTING
  CONFIRMING
  COMPLETED
  FAILED
  REVERSED
}

// ─── Users ───────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramId  BigInt     @unique @map("telegram_id")
  username    String?    @db.VarChar(64)
  firstName   String     @map("first_name") @db.VarChar(128)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  balances            Balance[]
  dealsAsBuyer       Deal[]     @relation("BuyerDeals")
  dealsAsSeller      Deal[]     @relation("SellerDeals")
  transactions        Transaction[]
  ledgerEntries       LedgerEntry[]
  disputesOpened      Dispute[]   @relation("DisputeOpener")
  disputesResolved    Dispute[]   @relation("DisputeResolver")
  adminActions        AdminAction[]
  withdrawalRequests  WithdrawalRequest[]
  blockchainDeposits  BlockchainDeposit[]
  depositAddresses    DepositAddress[]
  paymentReports      PaymentReport[] @relation("PaymentReporter")
  verifiedPayments    PaymentReport[] @relation("PaymentVerifier")
  escrowAuditLogs     EscrowAuditLog[]
  adminSettings       AdminSetting[]

  @@map("users")
}

// ─── Balances (dual-layer: available + locked) ───────────────────────────

model Balance {
  userId    String  @map("user_id") @db.Uuid
  asset     String  @db.VarChar(10)
  available Decimal @default(0) @db.Decimal(18, 8)
  locked    Decimal @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, asset])
  @@map("balances")
}

// ─── Deals ───────────────────────────────────────────────────────────────
// No deal-specific deposit fields. Deposits go to user wallets first.
// Deals are funded from available balance.

model Deal {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteCode           String        @unique @map("invite_code") @db.VarChar(12)
  buyerId              String        @map("buyer_id") @db.Uuid
  sellerId             String?       @map("seller_id") @db.Uuid
  asset                String        @db.VarChar(10) // USDT / INR / BTC ... payment denomination
  network              String        @db.VarChar(20) // TRC20 / BEP20 / UPI ... denomination
  amount               Decimal       @db.Decimal(18, 8)
  buyerFeeBps          Int           @default(100) @map("buyer_fee_bps") // basis points, e.g. 100 = 1%
  sellerFeeBps         Int           @default(100) @map("seller_fee_bps")
  buyerFeeAmount       Decimal       @default(0) @map("buyer_fee_amount") @db.Decimal(18, 8) // fee recorded at payment verification
  sellerFeeAmount      Decimal       @default(0) @map("seller_fee_amount") @db.Decimal(18, 8) // fee recorded at release
  // ── Manual payment verification (escrower-verified, no custody) ──
  paymentMethod        PaymentMethod @default(CRYPTO) @map("payment_method")
  // Who sends USDT to the escrow (USDT deals only). BUYER or SELLER.
  cryptoPayer          CryptoPayer?  @map("crypto_payer")
  currency             String?       @db.VarChar(10) // INR or asset symbol (USDT, BTC...)
  paymentReference     String?       @map("payment_reference") @db.VarChar(256)
  // ── Escrow admin acceptance (group deal card) ──
  acceptedBy           String?       @map("accepted_by") @db.Uuid
  acceptedAt           DateTime?     @map("accepted_at") @db.Timestamptz()
  paymentInstructionsSentAt DateTime? @map("payment_instructions_sent_at") @db.Timestamptz()
  // The group message where the deal card lives (the message is the deal reference).
  groupChatId          String?       @map("group_chat_id") @db.VarChar(64)
  groupMessageId       Int?          @map("group_message_id")
  paymentReportedAt    DateTime?     @map("payment_reported_at") @db.Timestamptz()
  paymentReportedBy    String?       @map("payment_reported_by") @db.Uuid
  paymentVerifiedAt    DateTime?     @map("payment_verified_at") @db.Timestamptz()
  paymentVerifiedBy    String?       @map("payment_verified_by") @db.Uuid
  paymentEvidence      String?       @map("payment_evidence") @db.Text
  paymentNotes         String?       @map("payment_notes") @db.Text
  // ── Release request / agreement / partial manual release ──
  releaseRequestedAt   DateTime?     @map("release_requested_at") @db.Timestamptz()
  releaseRequestedBy   String?       @map("release_requested_by") @db.Uuid
  releaseRequestedAmount Decimal?    @map("release_requested_amount") @db.Decimal(18, 8)
  releaseRequestedFrom String?       @map("release_requested_from") @db.VarChar(20) // state before the request
  releaseAgreedBy      String?       @map("release_agreed_by") @db.Uuid
  releaseAgreedAt      DateTime?     @map("release_agreed_at") @db.Timestamptz()
  releasedAmount       Decimal       @default(0) @map("released_amount") @db.Decimal(18, 8) // cumulative
  releasedAt           DateTime?     @map("released_at") @db.Timestamptz()
  releasedBy           String?       @map("released_by") @db.Uuid
  payoutReference      String?       @map("payout_reference") @db.VarChar(256)
  payoutMethod         String?       @map("payout_method") @db.VarChar(20)
  sellerPayoutAmount   Decimal?      @map("seller_payout_amount") @db.Decimal(18, 8)
  escrowFeeAmount      Decimal?      @map("escrow_fee_amount") @db.Decimal(18, 8) // buyer fee + seller fee
  // ── Refund request / agreement / partial manual refund ──
  refundRequestedAt    DateTime?     @map("refund_requested_at") @db.Timestamptz()
  refundRequestedBy    String?       @map("refund_requested_by") @db.Uuid
  refundRequestedAmount Decimal?     @map("refund_requested_amount") @db.Decimal(18, 8)
  refundRequestedFrom  String?       @map("refund_requested_from") @db.VarChar(20) // state before the request
  refundAgreedBy       String?       @map("refund_agreed_by") @db.Uuid
  refundAgreedAt       DateTime?     @map("refund_agreed_at") @db.Timestamptz()
  refundedAmount       Decimal       @default(0) @map("refunded_amount") @db.Decimal(18, 8) // cumulative
  refundedAt           DateTime?     @map("refunded_at") @db.Timestamptz()
  refundedBy           String?       @map("refunded_by") @db.Uuid
  refundReference      String?       @map("refund_reference") @db.VarChar(256)
  // Remaining escrow principal (deal amount - released - refunded).
  remainingAmount      Decimal?      @map("remaining_amount") @db.Decimal(18, 8)
  description          String        @db.Text
  category             DealCategory
  status               DealStatus
  expiresAt            DateTime?     @map("expires_at") @db.Timestamptz()
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz()

  buyer  User?  @relation("BuyerDeals", fields: [buyerId], references: [id])
  seller User?  @relation("SellerDeals", fields: [sellerId], references: [id])

  transactions   Transaction[]
  ledgerEntries LedgerEntry[]
  dispute       Dispute?
  adminActions  AdminAction[]
  paymentReports PaymentReport[]
  auditLogs      EscrowAuditLog[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status])
  @@index([status, expiresAt])
  @@map("deals")
}

// ─── Ledger Transactions (grouping container) ────────────────────────────
// Every economic event is a LedgerTransaction containing 2+ LedgerEntries
// that MUST net to zero.

model LedgerTransaction {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String           @db.VarChar(32) // DEPOSIT, ESCROW_FUND, ESCROW_RELEASE, REFUND, WITHDRAWAL, WITHDRAWAL_REVERSAL
  asset           String           @db.VarChar(10)
  amount          Decimal          @db.Decimal(18, 8) // principal amount for this operation
  network         String?          @db.VarChar(20)
  idempotencyKey  String           @unique @map("idempotency_key") @db.VarChar(128)
  dealId          String?          @map("deal_id") @db.Uuid
  referenceType   String?          @map("reference_type") @db.VarChar(32)
  referenceId     String?          @map("reference_id") @db.Uuid
  entries         LedgerEntry[]
  withdrawalReqs  WithdrawalRequest[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([type, createdAt])
  @@index([dealId])
  @@index([idempotencyKey])
  @@map("ledger_transactions")
}

// ─── Ledger Entries (immutable, double-entry) ─────────────────────────────
// Positive = credit, Negative = debit.
// balanceAfter = the user's available+locked total for this asset AFTER this entry.

model LedgerEntry {
  id             BigInt            @id @default(autoincrement())
  ledgerTxId     String            @map("ledger_tx_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  dealId         String?           @map("deal_id") @db.Uuid
  type           LedgerEntryType
  amount         Decimal           @db.Decimal(18, 8)  // signed: positive=credit, negative=debit
  asset          String            @db.VarChar(10)
  balanceAfter   Decimal           @map("balance_after") @db.Decimal(18, 8) // available+locked after this op
  referenceType  ReferenceType?
  referenceId    String?           @map("reference_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  ledgerTx   LedgerTransaction @relation(fields: [ledgerTxId], references: [id])
  user       User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal       Deal?  @relation(fields: [dealId], references: [id])

  @@index([userId, createdAt])
  @@index([ledgerTxId])
  @@map("ledger_entries")
}

// ─── Deposit Addresses (per-user HD-wallet derived addresses) ────────────
// Maps user -> deposit address per network/asset. Addresses are derived
// deterministically from DEPOSIT_HD_MNEMONIC (BIP-44) and persisted so the
// same address is reused for a user/network and so the blockchain monitor
// can attribute a deposit by (network, asset, address) -> userId.

model DepositAddress {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  network   String   @db.VarChar(20)
  asset     String   @db.VarChar(10)
  address   String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([network, asset, address], name: "deposit_address_unique")
  @@index([userId, network, asset])
  @@index([network, asset, address])
  @@map("deposit_addresses")
}

// ─── Blockchain Deposits (tracks on-chain deposits to user wallets) ──────
// Unique on (network, txHash, logIndex) to prevent double-crediting.

model BlockchainDeposit {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  txHash          String           @map("tx_hash") @db.VarChar(128)
  logIndex        Int              @default(0) @map("log_index")
  fromAddress     String           @map("from_address") @db.VarChar(128)
  toAddress       String           @map("to_address") @db.VarChar(128)
  asset           String           @db.VarChar(10)
  network         String           @db.VarChar(20)
  amount          Decimal          @db.Decimal(18, 8)
  confirmations   Int              @default(0)
  requiredConfs   Int              @default(20) @map("required_confs")
  status          TransactionStatus @default(PENDING)
  creditedAt      DateTime?        @map("credited_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([network, txHash, logIndex], name: "blockchain_deposit_unique")
  @@index([userId, createdAt])
  @@index([status, network])
  @@index([toAddress])
  @@map("blockchain_deposits")
}

// ─── Transactions (user-facing view) ─────────────────────────────────────

model Transaction {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      TransactionType
  asset     String           @db.VarChar(10)
  amount    Decimal          @db.Decimal(18, 8)
  status    TransactionStatus @default(PENDING)
  txHash    String?          @map("tx_hash") @db.VarChar(128)
  dealId    String?          @map("deal_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal? @relation(fields: [dealId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("transactions")
}

// ─── Withdrawal Requests ─────────────────────────────────────────────────

model WithdrawalRequest {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  asset           String                 @db.VarChar(10)
  amount          Decimal                @db.Decimal(18, 8)
  network         String                 @db.VarChar(20)
  toAddress       String                 @map("to_address") @db.VarChar(128)
  status          WithdrawalRequestStatus @default(PENDING)
  idempotencyKey  String                 @unique @map("idempotency_key") @db.VarChar(128)
  txHash          String?                @map("tx_hash") @db.VarChar(128)
  ledgerTxId      String?                @map("ledger_tx_id") @db.Uuid
  error           String?                @db.Text
  reservedAt      DateTime?              @map("reserved_at") @db.Timestamptz()
  queuedAt        DateTime?              @map("queued_at") @db.Timestamptz()
  broadcastAt     DateTime?              @map("broadcast_at") @db.Timestamptz()
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz()
  failedAt        DateTime?              @map("failed_at") @db.Timestamptz()
  reversedAt      DateTime?              @map("reversed_at") @db.Timestamptz()
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  user    User              @relation(fields: [userId], references: [id])
  ledgerTx LedgerTransaction? @relation(fields: [ledgerTxId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

// ─── Payment Reports (manual escrower-verified payments) ────────────────
// A buyer reports that they paid the escrower manually (outside the bot).
// The escrower/admin then verifies or rejects the report. The bot NEVER
// credits, monitors or moves funds — this is an audit record only.

model PaymentReport {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId          String            @map("deal_id") @db.Uuid
  reportedBy      String            @map("reported_by") @db.Uuid
  paymentMethod   PaymentMethod     @map("payment_method")
  amount          Decimal           @db.Decimal(18, 8)
  reference       String?           @db.VarChar(256)
  evidence        String?           @db.Text
  notes           String?           @db.Text
  status          PaymentReportStatus @default(PENDING)
  verifiedBy      String?           @map("verified_by") @db.Uuid
  verifiedAt      DateTime?         @map("verified_at") @db.Timestamptz()
  rejectedAt      DateTime?         @map("rejected_at") @db.Timestamptz()
  rejectionReason String?           @map("rejection_reason") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  deal     Deal? @relation(fields: [dealId], references: [id])
  reporter User? @relation("PaymentReporter", fields: [reportedBy], references: [id])
  verifier User? @relation("PaymentVerifier", fields: [verifiedBy], references: [id])

  @@index([dealId, createdAt])
  @@index([status])
  @@map("payment_reports")
}

// ─── Escrow Audit Log (manual financial events) ─────────────────────────
// Append-only record of every manual escrow financial event. The bot has no
// custody of funds, so these entries replace ledger mutations for the manual
// workflow. Every event identifies deal, actor, amount, currency, reference.

model EscrowAuditLog {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId        String           @map("deal_id") @db.Uuid
  action        EscrowAuditAction
  userId        String?          @map("user_id") @db.Uuid
  actorUsername String?          @map("actor_username") @db.VarChar(64)
  amount        Decimal?         @db.Decimal(18, 8)
  currency      String?          @db.VarChar(10)
  reference     String?          @db.VarChar(256)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  deal Deal? @relation(fields: [dealId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([dealId, createdAt])
  @@index([action])
  @@map("escrow_audit_logs")
}

// ─── Admin Settings (admin-entered escrow payment details) ─────────────
// Only authorized admins can modify these. The bot NEVER generates these
// values — they are the escrower's own receiving details, entered via
// /settings in the bot. Env vars (ESCROW_UPI_ID etc.) are used only as a
// fallback when a setting has not been entered yet.

model AdminSetting {
  key       String    @id @db.VarChar(64)
  value     String    @db.Text
  updatedBy String?   @map("updated_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  admin User? @relation(fields: [updatedBy], references: [id])

  @@map("admin_settings")
}

// ─── Disputes ─────────────────────────────────────────────────────────────

model Dispute {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId         String             @unique @map("deal_id") @db.Uuid
  openedBy       String             @map("opened_by") @db.Uuid
  reason         String             @db.Text
  status         DisputeStatus      @default(OPENED)
  resolution     DisputeResolution?
  assignedAdmin  String?            @map("assigned_admin") @db.Uuid
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz()
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  deal          Deal?  @relation(fields: [dealId], references: [id])
  opener        User?  @relation("DisputeOpener", fields: [openedBy], references: [id])
  resolver      User?  @relation("DisputeResolver", fields: [assignedAdmin], references: [id])
  evidence      DisputeEvidence[]

  @@map("disputes")
}

// ─── Dispute Evidence ────────────────────────────────────────────────────

model DisputeEvidence {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  submittedBy String  @map("submitted_by") @db.Uuid
  message   String   @db.Text
  fileType  String?  @map("file_type") @db.VarChar(50)
  fileId    String?  @map("file_id") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_evidence")
}

// ─── Admin Actions (audit trail for admin financial ops) ─────────────────

model AdminAction {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String           @map("admin_id") @db.Uuid
  actionType AdminActionType @map("action_type")
  dealId    String?          @map("deal_id") @db.Uuid
  reason    String           @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  admin User @relation(fields: [adminId], references: [id])
  deal  Deal? @relation(fields: [dealId], references: [id])

  @@index([adminId, createdAt])
  @@map("admin_actions")
}